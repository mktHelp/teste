    {
      "id": "b3a1c0de-0005-4000-8000-000000000005",
      "name": "E-mail de confirmação (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        200
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const b = $('Webhook').item.json.body;\n  const esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n  const w = String(b.whatsapp ?? '').replace(/\\D/g, '');\n  const whats = w.length === 11 ? '(' + w.slice(0, 2) + ') ' + w.slice(2, 7) + '-' + w.slice(7) : w;\n  const html = \"<div style=\\\"background:#F4F5F7;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;color:#1A2936\\\">\\n  <div style=\\\"max-width:560px;margin:0 auto;background:#FFFFFF;border-radius:24px;overflow:hidden\\\">\\n    <div style=\\\"background:#1A2936;padding:28px 32px\\\">\\n      <span style=\\\"display:inline-block;background:#FFD400;color:#1A2936;font-weight:700;font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:6px 12px;border-radius:999px\\\">Help Multas Franquias</span>\\n    </div>\\n    <div style=\\\"padding:32px\\\">\\n      <h1 style=\\\"margin:0 0 12px;font-size:24px;line-height:1.25\\\">Olá, {{PRIMEIRO_NOME}}! Recebemos seu interesse.</h1>\\n      <p style=\\\"margin:0 0 16px;font-size:16px;line-height:1.6;color:#3D5161\\\">\\n        Obrigado por querer fazer parte da rede Help Multas. Nosso time de expansão vai falar com você\\n        pelo WhatsApp <strong>{{WHATSAPP}}</strong> para apresentar o modelo de negócio.\\n      </p>\\n      <p style=\\\"margin:0 0 8px;font-size:14px;color:#5B6D7C\\\">Próximos passos:</p>\\n      <ol style=\\\"margin:0 0 24px;padding-left:20px;font-size:15px;line-height:1.8;color:#1A2936\\\">\\n        <li>Contato de um consultor de expansão</li>\\n        <li>Apresentação completa da franquia</li>\\n        <li>Análise do seu perfil e da sua região ({{CIDADE}}/{{UF}})</li>\\n      </ol>\\n      <p style=\\\"margin:0;font-size:13px;color:#8493A0\\\">Se não foi você que preencheu o formulário, ignore este e-mail.</p>\\n    </div>\\n  </div>\\n</div>\"\n    .replace('{{PRIMEIRO_NOME}}', esc(String(b.nome ?? '').trim().split(/\\s+/)[0]))\n    .replace('{{WHATSAPP}}', esc(whats))\n    .replace('{{CIDADE}}', esc(b.cidade))\n    .replace('{{UF}}', esc(b.uf));\n  return JSON.stringify({\n    from: 'Help Multas Franquias <franquias@SEU-DOMINIO-VERIFICADO.com.br>',\n    to: [b.email],\n    subject: 'Recebemos seu interesse em ser franqueado Help Multas',\n    html,\n  });\n})() }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Resend API (Authorization: Bearer re_...)"
        }
      }
