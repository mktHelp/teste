# URL que recebe o POST do formulário (CRM, webhook, n8n, Zapier, API própria...)
# Sem essa variável, o envio é apenas simulado no console.
VITE_LEAD_ENDPOINT=

# ID do container do Google Tag Manager (ex.: GTM-XXXXXXX).
# Sem essa variável, o GTM roda em MODO SIMULAÇÃO (dataLayer + painel de debug, sem tags reais).
VITE_GTM_ID=
